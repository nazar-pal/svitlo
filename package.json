{
  "name": "svitlo",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "scripts": {
    "start": "expo start",
    "dev": "EXPO_PUBLIC_APP_VARIANT=development npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "auth:generate": "bunx auth@latest generate --config src/data/server/auth.ts --output src/data/server/db-schema/auth.ts --yes",
    "auth:secret": "bunx auth@latest secret",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "gen:cascade-edges": "bun run scripts/generate-cascade-edges.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md}\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "flt": "npm run format && npm run lint && npm run typecheck",
    "fltt": "npm run format && npm run lint && npm run typecheck && npm run test",
    "ota:prod": "eas update --channel production --environment production --platform ios",
    "e2e": "maestro test .maestro/",
    "e2e:auth": "maestro test .maestro/flows/auth/",
    "e2e:generators": "maestro test .maestro/flows/generators/",
    "e2e:maintenance": "maestro test .maestro/flows/maintenance/",
    "e2e:org": "maestro test .maestro/flows/organization/",
    "e2e:nav": "maestro test .maestro/flows/navigation/",
    "e2e:smoke": "maestro test --include-tags smoke .maestro/",
    "prepare": "husky"
  },
  "dependencies": {
